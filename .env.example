# App (bundled into the app at build time; these are public by design)
VITE_SUPABASE_URL="https://your-project-ref.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="your-supabase-publishable-or-anon-key"
VITE_SUPABASE_PROJECT_ID="your-project-ref"
# RevenueCat public iOS key (appl_...). Never commit test_ keys.
VITE_REVENUECAT_IOS_KEY="appl_your_revenuecat_ios_key"

# Server secrets do NOT go here. Set them on Supabase with:
#   supabase secrets set OPENAI_API_KEY=sk-... REVENUECAT_SECRET_KEY=sk_...
# Optional: OPENAI_CHAT_MODEL, OPENAI_RECEIPT_MODEL (default gpt-5-mini)
